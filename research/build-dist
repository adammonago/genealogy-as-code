#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
  exec python3 "${REPO_ROOT}/scripts/build-dist.py" "$@"
elif command -v python >/dev/null 2>&1; then
  exec python "${REPO_ROOT}/scripts/build-dist.py" "$@"
else
  echo "Error: python3 or python is required to build distributions." >&2
  exit 2
fi
