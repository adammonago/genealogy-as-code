# Copy to .env.local and set absolute paths for your machine.
# .env.local is gitignored; do not commit private paths or credentials.

VAULT_PATH="/absolute/path/to/your/genealogy-vault"
# Community corpus of place bundles. Not the genealogy-as-code toolkit root.
OKF_BUNDLE_PATH="/absolute/path/to/your-community-corpus"

# Optional: place slug matching a bundle directory under OKF_BUNDLE_PATH.
# When set with OKF_BUNDLE_PATH, agents load {OKF_BUNDLE_PATH}/{OKF_TOWN}/index.md
# as read-only community context. You may also record the slug in Data_Inventory.md.
# OKF_TOWN="town-slug"
